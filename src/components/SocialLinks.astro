---

<ul class="social" aria-label="Social links">
	{
		SOCIAL_LINKS.map((s) => (
			<li>
				<a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
					<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
						<path fill="currentColor" d={icons[s.key]} />
					</svg>
				</a>
			</li>
		))
	}
</ul>

<style>
	.social {
		display: flex;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.social a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		color: var(--muted);
		border-radius: 999px;
		transition: color 0.12s ease, background 0.12s ease;
	}
	.social a:hover {
		color: var(--ink);
		background: var(--amber);
	}
</style>
